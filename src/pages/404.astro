---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <div class="container">
    <p class="label">404</p>
    <h1>Page not found</h1>
    <p class="text">The page you are looking for does not exist or has moved.</p>
    <a class="btn" href="/">Go home</a>
  </div>
</BaseLayout>

<style>
  .container {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .text {
    color: var(--muted);
  }
</style>
