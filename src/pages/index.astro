---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPosts } from '../lib/posts';
import { site } from '../site.config';

const recentPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <div class="container stack">
    <section class="intro panel" aria-labelledby="intro-title">
      <p class="label">About</p>
      <h1 id="intro-title">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="bio">
        <p>
          A short paragraph about you: what you work on, what you care about, and what you like
          building. Replace this text in <code>src/pages/index.astro</code>.
        </p>
        <p>
          A second paragraph for anything else worth knowing: past work, current interests, or what
          you write about on the blog.
        </p>
      </div>
      <SocialLinks />
    </section>

    <section aria-labelledby="recent-title">
      <div class="section-head">
        <h2 id="recent-title" class="label">Recent writing</h2>
        <a class="all mono" href="/blog">All posts <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      </div>
      <PostList posts={recentPosts} />
    </section>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.5rem);
  }

  .intro {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .bio {
    display: grid;
    gap: 0.75rem;
    color: var(--muted);
  }

  .bio code {
    font-family: var(--font-mono);
    font-size: 0.875em;
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.75rem;
    text-decoration: none;
  }
</style>
