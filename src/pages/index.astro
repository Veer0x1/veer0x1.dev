---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryList from '../components/EntryList.astro';
import PostList from '../components/PostList.astro';
import Section from '../components/Section.astro';
import SkillGroups from '../components/SkillGroups.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { about, achievements, education, experience, projects, skills } from '../data/profile';
import { blogUrl, getPosts } from '../lib/posts';
import { site } from '../site.config';

const recentPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <div class="container stack">
    <section class="intro panel" aria-labelledby="intro-title">
      <p class="label">About</p>
      <h1 id="intro-title">{site.name}</h1>
      <p class="tagline">{site.tagline}</p>
      <div class="bio">
        {about.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <SocialLinks />
    </section>

    <Section id="experience" title="Experience">
      <EntryList entries={experience} />
    </Section>

    <Section id="projects" title="Projects">
      <EntryList entries={projects} />
    </Section>

    <Section id="recent" title="Recent writing">
      <a slot="action" class="all mono" href={blogUrl}>All posts <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
      <PostList posts={recentPosts} />
    </Section>

    <Section id="skills" title="Skills">
      <SkillGroups groups={skills} />
    </Section>

    <Section id="education" title="Education">
      <EntryList entries={education} />
    </Section>

    <Section id="achievements" title="Leadership & achievements">
      <EntryList entries={achievements} />
    </Section>
  </div>
</BaseLayout>

<style>
  .stack {
    display: grid;
    gap: clamp(2.5rem, 6vw, 3.5rem);
  }

  .intro {
    display: grid;
    gap: 1rem;
    padding: clamp(1.25rem, 5vw, 2.5rem);
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent);
  }

  .bio {
    display: grid;
    gap: 0.75rem;
    color: var(--muted);
  }

  .all {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.75rem;
    text-decoration: none;
  }
</style>
