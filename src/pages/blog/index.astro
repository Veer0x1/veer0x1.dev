---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, tagsUrl } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes and articles on software engineering.">
  <div class="container">
    <header>
      <p class="label">Writing</p>
      <h1>Blog</h1>
      <p class="lede">Notes and articles on software engineering.</p>
      <a class="tags-link mono" href={tagsUrl}>Browse by tag <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
    </header>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  header {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .lede {
    color: var(--muted);
  }

  .tags-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: 0.75rem;
    text-decoration: none;
  }
</style>
