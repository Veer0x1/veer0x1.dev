---
import { Icon } from 'astro-icon/components';
---

<button class="theme-toggle" type="button" aria-label="Toggle color theme">
  <Icon name="lucide:sun" class="sun" aria-hidden="true" />
  <Icon name="lucide:moon" class="moon" aria-hidden="true" />
</button>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    button.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    font-size: 1rem;
    color: var(--muted);
    background: transparent;
    border: 1px var(--box-border-style) var(--border);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  /* Show the icon for the theme you would switch to */
  :root[data-theme='dark'] .moon,
  :root[data-theme='light'] .sun {
    display: none;
  }
</style>
