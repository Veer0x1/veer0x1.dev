---
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import { postUrl, readingTime, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty mono">No posts yet.</p>
  ) : (
    <ul class="panel">
      {posts.map((post) => (
        <li class="item">
          <p class="meta mono">
            <FormattedDate date={post.data.pubDate} />
            <span>{readingTime(post)}</span>
          </p>
          <div class="body">
            <a class="title" href={postUrl(post)}>
              {post.data.title}
              {post.data.draft && <span class="draft mono">draft</span>}
            </a>
            <p class="description">{post.data.description}</p>
            <TagList tags={post.data.tags} />
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  ul {
    padding: 0;
    list-style: none;
  }

  /* The title link stretches over the whole row; tag links sit above it */
  .item {
    position: relative;
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 1rem 1.25rem;
  }

  .item + .item {
    border-top: 1px var(--divider-style) var(--border);
  }

  .item:hover,
  .item:focus-within {
    background: var(--surface-hover);
  }

  /* Phones: date and reading time on one line above the title.
     Wider screens: both stacked in a column beside the title. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    font-size: 0.75rem;
    line-height: 1.9;
    color: var(--muted);
  }

  .meta > :global(:not(:first-child))::before {
    content: '|' / '';
    margin-right: 0.75rem;
    color: var(--border-strong);
  }

  @media (min-width: 40rem) {
    .item {
      grid-template-columns: 7.5rem 1fr;
    }

    .meta {
      flex-direction: column;
    }

    .meta > :global(:not(:first-child))::before {
      content: none;
    }
  }

  .body {
    display: grid;
    gap: 0.25rem;
  }

  .title {
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
    text-decoration: none;
  }

  .title::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .item:hover .title {
    color: var(--accent);
  }

  .description {
    font-size: 0.9em;
    color: var(--muted);
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0.1em 0.4em;
    font-size: 0.6875rem;
    color: var(--accent);
    border: 1px var(--box-border-style) var(--accent);
    vertical-align: middle;
  }

  .empty {
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
