---
import type { SkillGroup } from '../data/profile';

interface Props {
  groups: readonly SkillGroup[];
}

const { groups } = Astro.props;
---

<dl class="panel">
  {
    groups.map((group) => (
      <div class="group">
        <dt class="mono">{group.label}</dt>
        <dd>
          <ul>
            {group.items.map((item) => (
              <li class="mono">{item}</li>
            ))}
          </ul>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .group {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1rem 1.25rem;
  }

  .group + .group {
    border-top: 1px var(--divider-style) var(--border);
  }

  @media (min-width: 40rem) {
    .group {
      grid-template-columns: 9rem 1fr;
    }
  }

  dt {
    font-size: 0.75rem;
    line-height: 1.9;
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.2em 0.6em;
    font-size: 0.75rem;
    color: var(--text);
    border: 1px var(--box-border-style) var(--border-strong);
  }
</style>
